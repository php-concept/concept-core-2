{
    "name": "php-concept/core-2",
    "description": "Concept Framework Core Engine",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Concept\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "require": {
        "php": "^8.4",
        "league/route": "^6.2",
        "league/container": "^5.1",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-httphandlerrunner": "^2.13"
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyze --memory-limit=2G"
    }
}
